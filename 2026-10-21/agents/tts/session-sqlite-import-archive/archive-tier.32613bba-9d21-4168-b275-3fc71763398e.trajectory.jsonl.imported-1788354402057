,\n              \"SG\",\n              \"TH\",\n              \"MY\",\n              \"TW\",\n              \"PH\",\n              \"BR\"\n            ],\n            \"default\": \"UnKonw\"\n          }\n        }\n      }\n\n  /**\n   * 查询Tiktok平台产品详情\n   *\n   * @param productId 产品Id\n   * @param site? TikTok站点\n   */\n  function tiktok_product_detail(productId: string, site?: \"Unknow\" | \"US\" | \"MY\" | \"PH\" | \"VN\" | \"ID\" | \"GB\");\n      {\n        \"type\": \"object\",\n        \"properties\": {\n          \"productId\": {\n            \"description\": \"产品Id\",\n            \"type\": \"string\"\n          },\n          \"site\": {\n            \"description\": \"TikTok站点\",\n            \"type\": \"string\",\n            \"enum\": [\n              \"Unknow\",\n              \"US\",\n              \"MY\",\n              \"PH\",\n              \"VN\",\n              \"ID\",\n              \"GB\"\n            ],\n            \"default\": \"Unknow\"\n          }\n        },\n        \"required\": [\n          \"productId\"\n        ]\n      }\n\n  /**\n   * 搜索亚马逊电商平台上的潜力产品\n   *\n   * @param searchName? 可选参数，如果指定，将按此名称搜索相关产品\n   * @param price_min? 可选参数，如果指定表示筛选销售价大于等于此值的产品\n   * @param price_max? 可选参数，如果指定表示筛选销售价小于等于此值的产品\n   * @param month_sales_volume_min? 可选参数，如果指定表示筛选月销量大于等于此值的产品\n   * @param month_sales_volume_max? 可选参数，如果指定表示筛选月销量小于等于此值的产品\n   * @param delivery_type? 可选参数，如果指定，筛选产品的发货方式\n   * @param page? 查询结果的页码索引，默认为第1页。每页返回20条数据\n   * @param amzSite? 亚马逊站点\n   */\n  function potential_product(searchName?: string, price_min?: number, price_max?: number, month_sales_volume_min?: number, month_sales_volume_max?: number);\n  // optional (3): delivery_type, page, amzSite\n      {\n        \"type\": \"object\",\n        \"properties\": {\n          \"searchName\": {\n            \"description\": \"可选参数，如果指定，将按此名称搜索相关产品\",\n            \"type\": \"string\",\n            \"default\": \"\"\n          },\n          \"price_min\": {\n            \"description\": \"可选参数，如果指定表示筛选销售价大于等于此值的产品\",\n            \"type\": \"number\",\n            \"default\": -9999\n          },\n          \"price_max\": {\n            \"description\": \"可选参数，如果指定表示筛选销售价小于等于此值的产品\",\n            \"type\": \"number\",\n            \"default\": -9999\n          },\n          \"month_sales_volume_min\": {\n            \"description\": \"可选参数，如果指定表示筛选月销量大于等于此值的产品\",\n            \"type\": \"integer\",\n            \"default\": -9999\n          },\n          \"month_sales_volume_max\": {\n            \"description\": \"可选参数，如果指定表示筛选月销量小于等于此值的产品\",\n            \"type\": \"integer\",\n            \"default\": -9999\n          },\n          \"delivery_type\": {\n            \"description\": \"可选参数，如果指定，筛选产品的发货方式\",\n            \"type\": \"string\",\n            \"enum\": [\n              \"Both\",\n              \"FBM\",\n              \"FBA\"\n            ],\n            \"default\": \"Both\"\n          },\n          \"page\": {\n            \"description\": \"查询结果的页码索引，默认为第1页。每页返回20条数据\",\n            \"type\": \"integer\",\n            \"default\": 1\n          },\n          \"amzSite\": {\n            \"description\": \"亚马逊站点\",\n            \"type\": \"string\",\n            \"enum\": [\n              \"Unknow\",\n              \"US\",\n              \"GB\",\n              \"DE\"\n            ],\n            \"default\": \"Unknow\"\n          }\n        }\n      }\n\n  /**\n   * 查询Tiktok平台产品趋势，同时返回`销量`，`价格`，`星级`，`评论数量`，`新增带货视频数`，`新增带货达人数`多个维度\n   *\n   * @param productId 产品Id\n   * @param site? TikTok站点\n   */\n  function tiktok_product_trend(productId: string, site?: \"Unknow\" | \"US\" | \"MY\" | \"PH\" | \"VN\" | \"ID\" | \"GB\");\n      {\n        \"type\": \"object\",\n        \"properties\": {\n          \"productId\": {\n            \"description\": \"产品Id\",\n            \"type\": \"string\"\n          },\n          \"site\": {\n            \"description\": \"TikTok站点\",\n            \"type\": \"string\",\n            \"enum\": [\