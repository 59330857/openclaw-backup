果指定表示筛选销售价大于等于此值的产品\",\n            \"type\": \"number\",\n            \"default\": -9999\n          },\n          \"price_max\": {\n            \"description\": \"可选参数，如果指定表示筛选销售价小于等于此值的产品\",\n            \"type\": \"number\",\n            \"default\": -9999\n          },\n          \"month_sales_volume_min\": {\n            \"description\": \"可选参数，如果指定表示筛选月销量大于等于此值的产品\",\n            \"type\": \"integer\",\n            \"default\": -9999\n          },\n          \"month_sales_volume_max\": {\n            \"description\": \"可选参数，如果指定表示筛选月销量小于等于此值的产品\",\n            \"type\": \"integer\",\n            \"default\": -9999\n          },\n          \"delivery_type\": {\n            \"description\": \"可选参数，如果指定，筛选产品的发货方式\",\n            \"type\": \"string\",\n            \"enum\": [\n              \"Both\",\n              \"FBM\",\n              \"FBA\"\n            ],\n            \"default\": \"Both\"\n          },\n          \"page\": {\n            \"description\": \"查询结果的页码索引，默认为第1页。每页返回20条数据\",\n            \"type\": \"integer\",\n            \"default\": 1\n          },\n          \"amzSite\": {\n            \"description\": \"亚马逊站点\",\n            \"type\": \"string\",\n            \"enum\": [\n              \"Unknow\",\n              \"US\",\n              \"GB\",\n              \"DE\"\n            ],\n            \"default\": \"Unknow\"\n          }\n        }\n      }\n\n  /**\n   * 查询Tiktok平台产品趋势，同时返回`销量`，`价格`，`星级`，`评论数量`，`新增带货视频数`，`新增带货达人数`多个维度\n   *\n   * @param productId 产品Id\n   * @param site? TikTok站点\n   */\n  function tiktok_product_trend(productId: string, site?: \"Unknow\" | \"US\" | \"MY\" | \"PH\" | \"VN\" | \"ID\" | \"GB\");\n      {\n        \"type\": \"object\",\n        \"properties\": {\n          \"productId\": {\n            \"description\": \"产品Id\",\n            \"type\": \"string\"\n          },\n          \"site\": {\n            \"description\": \"TikTok站点\",\n            \"type\": \"string\",\n            \"enum\": [\n              \"U