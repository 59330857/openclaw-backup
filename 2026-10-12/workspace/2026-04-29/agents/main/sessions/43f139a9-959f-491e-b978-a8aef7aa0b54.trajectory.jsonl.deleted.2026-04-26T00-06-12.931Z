disableModelInvocation":false,"available":true},{"id":"node-connect","name":"node-connect","description":"Diagnose OpenClaw node connection and pairing failures for Android, iOS, and macOS companion apps. Use when QR/setup code/manual connect fails, local Wi-Fi works but VPS/tailnet does not, or errors mention pairing required, unauthorized, bootstrap token invalid or expired, gateway.bind, gateway.remote.url, Tailscale, or plugins.entries.device-pair.config.publicUrl.","filePath":"~/.npm-global/lib/node_modules/openclaw/skills/node-connect/SKILL.md","baseDir":"~/.npm-global/lib/node_modules/openclaw/skills/node-connect","source":"openclaw-bundled","sourceInfo":{"baseDir":"~/.npm-global/lib/node_modules/openclaw/skills/node-connect","origin":"top-level","path":"~/.npm-global/lib/node_modules/openclaw/skills/node-connect/SKILL.md","scope":"project","source":"openclaw-bundled"},"disableModelInvocation":false,"available":true},{"id":"searxng-search","name":"searxng-search","description":"SearXNG 元搜索引擎搜索。当用户需要搜索网络信息时使用，支持指定引擎、语言、时间范围、分类。不需要 API key，完全私有。支持普通搜索、图片搜索、新闻搜索。触发场景：(1) 用户说\"搜索一下...\"、\"帮我查一下...\" (2) 需要多引擎聚合结果时 (3) 替代 Google/Bing 单引擎搜索。","filePath":"$OPENCLAW_STATE_DIR/workspace/skills/searxng-search/SKILL.md","baseDir":"$OPENCLAW_STATE_DIR/workspace/skills/searxng-search","source":"openclaw-workspace","sourceInfo":{"baseDir":"$OPENCLAW_STATE_DIR/workspace/skills/searxng-search","origin":"top-level","path":"$OPENCLAW_STATE_DIR/workspace/skills/searxng-search/SKILL.md","scope":"project","source":"openclaw-workspace"},"disableModelInvocation":false,"available":true},{"id":"skill-creator","name":"skill-creator","description":"Guide for creating effective skills. This skill should be used when users want to create a new skill (or update an existing skill) that extends Claude's capabilities with specialized knowledge, workflows, or tool integrations.","filePath":"$OPENCLAW_STATE_DIR/workspace/skills/skill-creator/SKILL.md","baseDir":"$OPENCLAW_STATE_DIR/workspace/s