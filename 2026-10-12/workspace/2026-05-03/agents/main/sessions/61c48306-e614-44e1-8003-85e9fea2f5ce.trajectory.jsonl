ation payload for rich text, buttons, selects, and context. Core degrades unsupported blocks to text."},"messageId":{"type":"string","description":"Target message id for reaction. If omitted, defaults to the current inbound message id when available."},"message_id":{"type":"string","description":"snake_case alias of messageId. If omitted, defaults to the current inbound message id when available."},"emoji":{"type":"string"},"remove":{"type":"boolean"},"targetAuthor":{"type":"string"},"targetAuthorUuid":{"type":"string"},"groupId":{"type":"string"},"limit":{"type":"number"},"pageSize":{"type":"number"},"before":{"type":"string"},"after":{"type":"string"},"around":{"type":"string"},"fromMe":{"type":"boolean"},"includeArchived":{"type":"boolean"},"pollId":{"type":"string"},"pollOptionId":{"type":"string","description":"Poll answer id to vote for. Use when the channel exposes stable answer ids."},"pollOptionIds":{"type":"array","items":{"type":"string","description":"Poll answer ids to vote for in a multiselect poll. Use when the channel exposes stable answer ids."}},"pollOptionIndex":{"type":"number","description":"1-based poll option number to vote for, matching the rendered numbered poll choices."},"pollOptionIndexes":{"type":"array","items":{"type":"number","description":"1-based poll option numbers to vote for in a multiselect poll, matching the rendered numbered poll choices."}},"pollQuestion":{"type":"string"},"pollOption":{"type":"array","items":{"type":"string"}},"pollDurationHours":{"type":"number"},"pollMulti":{"type":"boolean"},"channelId":{"type":"string","description":"Channel id filter (search/thread list/event create)."},"chatId":{"type":"string","description":"Chat id for chat-scoped metadata actions."},"channelIds":{"type":"array","items":{"type":"string","description":"Channel id filter (repeatable)."}},"memberId":{"type":"string"},"memberIdType":{"type":"string"},"guildId":{"type":"string"},"userId":{"type":"string"},"openId":{"type":"string"},"union