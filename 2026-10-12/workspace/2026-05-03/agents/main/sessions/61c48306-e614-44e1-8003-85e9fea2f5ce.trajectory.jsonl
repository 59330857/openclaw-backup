s to indexed session transcripts (same visibility rules as session history tools). If response has disabled=true, memory retrieval is unavailable and should be surfaced to the user.","parameters":{"type":"object","required":["query"],"properties":{"query":{"type":"string"},"maxResults":{"type":"number"},"minScore":{"type":"number"},"corpus":{"anyOf":[{"type":"string","const":"memory"},{"type":"string","const":"wiki"},{"type":"string","const":"all"},{"type":"string","const":"sessions"}]}}}},{"name":"message","description":"Send, delete, and manage messages via channel plugins. Supports actions: broadcast, channel-info, channel-list, edit, list-pins, member-info, pin, react, reactions, read, send, thread-reply, unpin. Use action=\"read\" with threadId to fetch prior messages in a thread when you need conversation context you do not have yet.","parameters":{"type":"object","required":["action"],"properties":{"action":{"type":"string","enum":["send","broadcast","read","edit","thread-reply","pin","list-pins","unpin","member-info","channel-info","channel-list","react","reactions"]},"channel":{"type":"string"},"target":{"type":"string","description":"Recipient/channel: E.164 for WhatsApp/Signal, Telegram chat id/@username, Discord/Slack/Mattermost <channelId|user:ID|channel:ID>, or iMessage handle/chat_id"},"targets":{"type":"array","items":{"type":"string","description":"Recipient/channel targets (same format as --target); accepts ids or names when the directory is available."}},"accountId":{"type":"string"},"dryRun":{"type":"boolean"},"message":{"type":"string"},"effectId":{"type":"string","description":"Message effect name/id for sendWithEffect (e.g., invisible ink)."},"effect":{"type":"string","description":"Alias for effectId (e.g., invisible-ink, balloons)."},"media":{"type":"string","description":"Media URL or local path. data: URLs are not supported here, use buffer."},"filename":{"type":"string"},"buffer":{"type":"string","description":"Base64 payload for attachme