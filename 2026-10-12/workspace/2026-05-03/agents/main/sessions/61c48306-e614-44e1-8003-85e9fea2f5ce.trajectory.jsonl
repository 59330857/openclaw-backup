ption":"Feishu cloud storage operations. Actions: list, info, create_folder, move, delete, list_comments, list_comment_replies, add_comment, reply_comment","parameters":{"type":"object","properties":{"action":{"type":"string","enum":["list","info","create_folder","move","delete","list_comments","list_comment_replies","add_comment","reply_comment"]},"type":{"type":"string","enum":["doc","docx","sheet","bitable","folder","file","mindnote","shortcut"]},"name":{"type":"string","description":"Folder name"},"file_type":{"description":"Document type. Defaults to docx when omitted.","type":"string","enum":["doc","docx","sheet","file","slides"]},"page_size":{"type":"integer","minimum":1,"maximum":100,"description":"Page size"},"comment_id":{"type":"string","description":"Comment id"},"content":{"type":"string","description":"Comment text content"},"block_id":{"type":"string","description":"Optional docx block id for a local comment. Omit to create a full-document comment."}},"required":["action"],"additionalProperties":true}},{"name":"feishu_wiki","description":"Feishu knowledge base operations. Actions: spaces, nodes, get, create, move, rename","parameters":{"type":"object","properties":{"action":{"type":"string","enum":["spaces","nodes","get","search","create","move","rename"]},"space_id":{"type":"string","description":"Knowledge space ID"},"query":{"type":"string","description":"Search query"},"title":{"type":"string","description":"Node title"},"obj_type":{"anyOf":[{"type":"string","const":"docx"},{"type":"string","const":"sheet"},{"type":"string","const":"bitable"}],"description":"Object type (default: docx)"},"target_space_id":{"type":"string","description":"Target space ID (optional, same space if omitted)"}},"required":["action"],"additionalProperties":true}},{"name":"file_fetch","description":"Retrieve a file from a paired node by absolute path. Returns image content blocks for image MIME types, inlines small text files (≤8 KB) as text content, and saves everything 